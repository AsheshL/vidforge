  "cards": [
    {
      "dot": "cyan",
      "title": "Managed, not hand-built",
      "items": [
        "Every resource here is Terraform (infra/terraform/)",
        "CI deploys via GitHub OIDC to a repo-scoped IAM role — no long-lived AWS keys",
        "Rate-limit counters live in Redis too, shared fleet-wide across gateway replicas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Private by default",
      "items": [
        "ECS, RDS, and ElastiCache sit in private subnets",
        "S3 is reached via a VPC gateway endpoint, so transcode traffic skips the NAT"
      ]
    },
    {
      "dot": "rose",
      "title": "This is the IaC target, not necessarily live",
      "items": [
        "The AWS footprint was torn down 2026-09-25 after the feature freeze",
        "Verify live resources before assuming anything here is actually running"
      ]
    }
  ]
