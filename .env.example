# Copy to .env and adjust.
DATABASE_URL="postgresql://vidforge:vidforge@localhost:5432/vidforge"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="vidforge"
S3_SECRET_KEY="vidforge-secret"
S3_BUCKET="vidforge-media"
JWT_SECRET="change-me"
# Optional: during a JWT_SECRET rotation window, set this to the *previous*
# secret so tokens issued before the rotation still verify. See
# infra/terraform/README-secret-rotation.md.
# JWT_SECRET_PREVIOUS=""
API_GATEWAY_URL="http://127.0.0.1:4000"
VIDEO_SVC_ADDR="localhost:50051"
METADATA_SVC_ADDR="localhost:50052"
AUTH_SVC_ADDR="localhost:50053"

# HMAC secret the gateway uses to sign RequestContext for internal services.
# Must match across api-gateway, video-svc and auth-svc. Distinct from JWT_SECRET.
CONTEXT_SIGNING_SECRET="change-me-too"
# Optional: during a CONTEXT_SIGNING_SECRET rotation window, set this to the
# *previous* secret so contexts signed before the rotation still verify. See
# infra/terraform/README-secret-rotation.md.
# CONTEXT_SIGNING_SECRET_PREVIOUS=""

# Browser-reachable object storage endpoint embedded in presigned playback URLs.
# Defaults to S3_ENDPOINT when unset.
# S3_PUBLIC_ENDPOINT="http://localhost:9000"

# Invite emails (dev: Mailpit from docker-compose, UI at http://localhost:8025).
# In production this is the SES SMTP endpoint and credentials:
# SMTP_URL="smtps://<smtp-user>:<smtp-password>@email-smtp.eu-west-1.amazonaws.com:465"
SMTP_URL="smtp://localhost:1025"
TEMP_PASSWORD_TTL_HOURS=24

# Envelope sender. Must be an SES-verified identity in production or SES
# rejects the send.
MAIL_FROM="VidForge <no-reply@vidforge.local>"
# Pooling and pacing for the SMTP transport. MAIL_RATE_LIMIT is messages per
# second — keep it at or below the account's SES sending quota.
# MAIL_MAX_CONNECTIONS=5
# MAIL_RATE_LIMIT=14

# Trust X-Forwarded-For on the gateway: "true", a hop count ("1"), or a
# comma-separated list of trusted proxy IPs/CIDRs. Set it only when a proxy
# you control (the ALB) is the sole route to the gateway — otherwise callers
# can spoof their IP and walk around the auth rate limits.
# TRUST_PROXY="true"

# Where the gateway keeps rate-limit counters. Defaults to REDIS_URL; shared
# so the limits hold across gateway replicas instead of per-process.
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"

# How long SIGTERM'd processes get to finish in-flight work before forcing
# an exit. Keep below the platform stop timeout (ECS stopTimeout, compose
# stop_grace_period).
# SHUTDOWN_GRACE_MS=25000

# Webhook delivery (jobs-svc). Deliveries to private/loopback/link-local
# addresses are refused; set this to "true" to allow localhost receivers
# while developing. Ignored when NODE_ENV=production, which also requires
# https webhook URLs.
# WEBHOOK_ALLOW_PRIVATE_TARGETS="true"
# Parallel webhook deliveries per jobs-svc process.
# WEBHOOK_CONCURRENCY=10
