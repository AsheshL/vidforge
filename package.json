{
  "name": "vidforge",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "proto:gen": "turbo proto:gen",
    "db:migrate": "pnpm --filter @vidforge/db db:migrate",
    "db:generate": "pnpm --filter @vidforge/db db:generate",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
